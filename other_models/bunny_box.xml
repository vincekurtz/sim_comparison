<mujoco model="clutter">
  <option cone="elliptic" timestep="0.01"/>
  <asset>
    <mesh name="bunny_mesh" file="bunny.obj"/>
  </asset>
  <worldbody>
    <geom name="base" type="box" pos="0.0 0.0 0.0" size="20.0 20.0 0.05" rgba="0.2 0.5 0.2 1.0"/>
    <!--
    <geom name="left" type="box" pos="1.0 0.0 0.5" size="0.05 1.0 0.5" rgba="1.0 1.0 1.0 0.3"/>
    <geom name="right" type="box" pos="-1.0 0.0 0.5" size="0.05 1.0 0.5" rgba="1.0 1.0 1.0 0.3"/>
    <geom name="front" type="box" pos="0.0 1.0 0.5" size="1.0 0.05 0.5" rgba="1.0 1.0 1.0 0.3"/>
    <geom name="back" type="box" pos="0.0 -1.0 0.5" size="1.0 0.05 0.5" rgba="1.0 1.0 1.0 0.3"/>
        -->
    <body>
      <joint type="free"/>
      <geom name="bunny1" type="mesh" pos="0.0 0.0 0.8" mesh="bunny_mesh"/>
    </body>
    <body>
      <joint type="free"/>
      <geom name="bunny2" type="mesh" pos="0.0 0.0 2.0" mesh="bunny_mesh"/>
    </body>
    <body>
      <joint type="free"/>
      <geom name="bunny3" type="mesh" pos="0.0 0.0 3.2" mesh="bunny_mesh"/>
    </body>
    <!--
    <body>
      <joint type="free"/>
      <geom name="bunny4" type="mesh" pos="0.0 0.0 4.4" mesh="bunny_mesh"/>
    </body>
    <body>
      <joint type="free"/>
      <geom name="bunny5" type="mesh" pos="0.0 0.0 5.6" mesh="bunny_mesh"/>
      </body>
    -->
  </worldbody>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
  </worldbody>
</mujoco>
